{
  "#type": "for_each",
  "values": "$.organisation",
  "spec": {
    "organisation": {
      "id": "$.id",
      "name": "$.name",
      "reg_number": "$.regNumber",
      "website": "$.website",
      "href": "$.href",
      "addresses": {
        "#type": "for_each",
        "values": "$.addresses.address",
        "spec": {
          "organisation_id": "$$.id",
          "type": "$.type",
          "line1": "$.line1",
          "line2": "$.line2",
          "line3": "$.line3",
          "line4": "$.line4",
          "line5": "$.line5",
          "city": "$.city",
          "county": "$.county",
          "post_code": "$.postCode",
          "region": "$.region",
          "country": "$.country"
        }
      }
    },
    "links": {
      "#type": "for_each",
      "values": "$.links.link",
      "spec": {
        "organisation_id": "$$.id",
        "href": "$.href",
        "rel": "$.rel",
        "start_millis": "$.start",
        "end_millis": "$.end"
      }
    }
  }
}